# Fleet quote requests are emailed via https://formsubmit.co -- no API key
# needed. The target address is set directly in lib/data/fleet.ts. On the
# very first submission, FormSubmit sends an activation link to that inbox
# that must be clicked before notifications start being delivered.

# Real order tracking (Supabase). Get these at
# https://supabase.com/dashboard/project/jrlfdqynxvxjeouxgoyh/settings/api-keys
SUPABASE_URL=https://jrlfdqynxvxjeouxgoyh.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Admin area (/admin) that lets staff update order status. Change these to
# your own values -- ADMIN_PASSWORD is what you type in at /admin/login.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
