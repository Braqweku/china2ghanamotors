NEXT_PUBLIC_WHATSAPP_NUMBER=233203270251
NEXT_PUBLIC_CONTACT_EMAIL=jacob.knorr@ev3africa.com

# Required to actually send fleet enquiry emails (get a key at https://resend.com)
RESEND_API_KEY=

# Optional: once a sending domain is verified in Resend, e.g.
# RESEND_FROM_EMAIL="China2Ghana Motors <fleet@china2ghanamotors.com>"
# Until then, emails send from Resend's shared onboarding@resend.dev address.
RESEND_FROM_EMAIL=

# Until a domain is verified in Resend, it only allows sending to the
# account's own signup email -- fleet notifications route here instead of
# NEXT_PUBLIC_CONTACT_EMAIL so they actually get delivered. Remove once a
# domain is verified and notifications should go to the real contact email.
FLEET_NOTIFICATION_EMAIL=
